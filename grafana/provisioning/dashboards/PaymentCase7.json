{
  "uid": "payment-case7",
  "title": "Case 7 - Payment attempts and latency",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-15m", "to": "now"},
  "templating": {"list": [
    {"name": "datasource", "type": "datasource", "query": "prometheus", "refresh": 1},
    {"name": "job", "label": "Application scrape job", "type": "custom", "query": "online-store-job,online-shop-job", "current": {"text": "online-store-job", "value": "online-store-job"}},
    {"name": "instance", "type": "query", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "query": "label_values(payment_http_attempt_seconds_count{job=\"$job\"}, instance)", "refresh": 1},
    {"name": "account", "type": "custom", "query": "acc-7", "current": {"text": "acc-7", "value": "acc-7"}}
  ]},
  "panels": [
    {"id": 1, "title": "Explicit retries started (per second)", "description": "Incremented immediately before execute on attempts after the first. Does not count ingress rejections or internal OkHttp recovery.", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "$datasource"}, "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "reqps"}}, "targets": [
      {"refId": "A", "expr": "sum by (account) (rate(payment_retries_total{job=\"$job\",instance=\"$instance\",account=\"$account\"}[$__rate_interval]))", "legendFormat": "{{account}} retries/s"}
    ]},
    {"id": 2, "title": "Retries started in selected time range", "type": "stat", "datasource": {"type": "prometheus", "uid": "$datasource"}, "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "targets": [
      {"refId": "A", "instant": true, "expr": "sum(increase(payment_retries_total{job=\"$job\",instance=\"$instance\",account=\"$account\"}[$__range]))"}
    ]},
    {"id": 3, "title": "HTTP latency - p50 / p90 / p95 / p99", "description": "Approximate histogram quantiles of completed attempts, including failed attempts. Does not include currently stuck calls. No database or limiter waiting.", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "$datasource"}, "gridPos": {"x": 0, "y": 8, "w": 24, "h": 9}, "fieldConfig": {"defaults": {"unit": "s"}}, "targets": [
      {"refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(payment_http_attempt_seconds_bucket{job=\"$job\",instance=\"$instance\",account=\"$account\"}[$__rate_interval])))", "legendFormat": "p50"},
      {"refId": "B", "expr": "histogram_quantile(0.90, sum by (le) (rate(payment_http_attempt_seconds_bucket{job=\"$job\",instance=\"$instance\",account=\"$account\"}[$__rate_interval])))", "legendFormat": "p90"},
      {"refId": "C", "expr": "histogram_quantile(0.95, sum by (le) (rate(payment_http_attempt_seconds_bucket{job=\"$job\",instance=\"$instance\",account=\"$account\"}[$__rate_interval])))", "legendFormat": "p95"},
      {"refId": "D", "expr": "histogram_quantile(0.99, sum by (le) (rate(payment_http_attempt_seconds_bucket{job=\"$job\",instance=\"$instance\",account=\"$account\"}[$__rate_interval])))", "legendFormat": "p99"}
    ]},
    {"id": 4, "title": "Average HTTP latency", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "$datasource"}, "gridPos": {"x": 0, "y": 17, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "s"}}, "targets": [
      {"refId": "A", "expr": "sum(rate(payment_http_attempt_seconds_sum{job=\"$job\",instance=\"$instance\",account=\"$account\"}[$__rate_interval])) / sum(rate(payment_http_attempt_seconds_count{job=\"$job\",instance=\"$instance\",account=\"$account\"}[$__rate_interval]))", "legendFormat": "mean"}
    ]},
    {"id": 5, "title": "Completed HTTP attempts by outcome (per second)", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "$datasource"}, "gridPos": {"x": 12, "y": 17, "w": 12, "h": 8}, "fieldConfig": {"defaults": {"unit": "reqps"}}, "targets": [
      {"refId": "A", "expr": "sum by (outcome) (rate(payment_http_attempt_seconds_count{job=\"$job\",instance=\"$instance\",account=\"$account\"}[$__rate_interval]))", "legendFormat": "{{outcome}}"}
    ]}
  ]
}